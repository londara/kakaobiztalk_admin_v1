<?xml version="1.0" encoding="UTF-8"?>
<!--
  IRIS BizTalk Portal — build definition
  req: CONST-TECH-L01 (Java 17+ / Spring Boot 3.x / Spring Security), ADR-001, ADR-LOGIN-010
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.webcash.iris</groupId>
  <artifactId>iris-portal</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>IRIS BizTalk Portal</name>
  <description>Replacement for the legacy IRIS_ADMIN login and biztalk modules</description>

  <properties>
    <java.version>17</java.version>
    <!--
      req: RISK-007 — sources contain Korean Javadoc and the build machine's javac
      defaults to windows-1252 here. Stated explicitly rather than relying on the
      parent POM, because a silent encoding fallback corrupts comments rather than
      failing the build.
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis-starter.version>3.0.3</mybatis-starter.version>
    <bouncycastle.version>1.78.1</bouncycastle.version>
    <totp.version>1.7.1</totp.version>
    <archunit.version>1.3.0</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- req: ADR-003 / ADR-LOGIN-011 — MyBatis retained; legacy SQL ported near-verbatim -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-starter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- req: FR-LOGIN-005 — Argon2id. Spring Security's Argon2PasswordEncoder needs BouncyCastle -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!--
      req: ADR-LOGIN-010 — maintained TOTP library, NOT a port of GoogleOTP.java.
      Declared now; used in Sprint L2 (OTP verification and registration).
    -->
    <dependency>
      <groupId>dev.samstevens.totp</groupId>
      <artifactId>totp</artifactId>
      <version>${totp.version}</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- version managed by spring-boot-starter-parent -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Docker 금지(RISK-T13)로 Testcontainers 를 쓸 수 없다. embedded-postgres 는 실제 PostgreSQL
      바이너리를 프로세스로 띄우므로 Docker 없이 lpad 같은 실제 SQL 동작을 검증할 수 있다.
      라이선스는 Apache-2.0 이므로 CODE-004 상 문제가 없다.
      Docker is prohibited (RISK-T13) so Testcontainers is unusable. embedded-postgres launches a real
      PostgreSQL binary as a process, so genuine SQL behaviour such as lpad can be verified without
      Docker. Licensed Apache-2.0, so CODE-004 raises nothing.
    -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <version>2.0.7</version>
      <scope>test</scope>
    </dependency>
    <!--
      ADR-RPT-023 이 프로그램 차원에서 SXSSF 스트리밍 내보내기를 선택했으나, 그 작성기는
      이용기관 보고서 스프린트 R2 에 계획되고 아직 구현되지 않았다. 따라서 톡전송 내역
      슬라이스가 그것을 재사용하지 않고 만든다 — ADR-TLK-027 §5 에 정정을 남겼다.

      라이선스(CODE-004): Apache POI 는 Apache-2.0 이며 copyleft 의무가 없다. 레거시 스택에도
      이미 POI 3.9 가 있었으므로 새로운 라이선스 노출이 아니다 — 다만 3.9 는 지원이 끊긴
      버전이고 여기서는 5.x 를 쓴다.

      ADR-RPT-023 chose SXSSF streaming exports programme-wide, but that writer was planned for the
      이용기관 보고서 slice's Sprint R2 and has not been built. The 톡전송 내역 slice therefore builds
      it rather than reusing it — correction recorded in ADR-TLK-027 §5.

      Licensing (CODE-004): Apache POI is Apache-2.0 with no copyleft obligation. The legacy stack
      already carried POI 3.9, so this is not new licence exposure — though 3.9 is unsupported and
      5.x is used here.
    -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>
    <!--
      POI 5.2.5 는 commons-io 2.15 에서 추가된 UnsynchronizedByteArrayOutputStream.builder() 를
      호출하는데, spring-boot-starter-parent 가 관리하는 버전은 그보다 낮아 실행 중
      NoSuchMethodError 가 난다. 컴파일은 통과하므로 통합 시험만이 이것을 드러낸다 — 실제로
      TalkExportParityTest 의 워크북 시험이 첫 실행에서 잡았다.
      POI 5.2.5 calls UnsynchronizedByteArrayOutputStream.builder(), added in commons-io 2.15, while the
      version managed by spring-boot-starter-parent is older, so it fails at runtime with
      NoSuchMethodError. Compilation succeeds, so only an integration test finds it — TalkExportParityTest's
      workbook tests caught it on their first run.
    -->
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.16.1</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!--
          `mvn spring-boot:run` 시 local 프로파일을 기본 활성화한다.
          이 설정은 <b>run 골(개발용)에만</b> 적용되며, 패키징된 jar(운영 배포)에는 영향이
          없다. local 프로파일이 빠지면 require-https=true 로 실행되어 모든 요청이
          https://localhost:8443 으로 302 리다이렉트되고 "서버에 연결할 수 없습니다" 오류가
          난다 — 이 실수가 반복되어 기본값으로 고정한다.
          운영에서 HTTPS 를 강제하려면 profiles 없이 빌드된 jar 를 실행하면 된다.

          Activates the `local` profile by default for `mvn spring-boot:run`. This applies only to
          the run goal (development); a packaged jar (production) is unaffected. Without the local
          profile the app runs with require-https=true and 302-redirects everything to
          https://localhost:8443, producing the "cannot connect to server" error. Pinned here
          because this mistake has recurred; production simply runs the built jar with no profile.
        -->
        <configuration>
          <profiles>
            <profile>local</profile>
          </profiles>
        </configuration>
      </plugin>

      <!--
        req: TEST-PLAN-LOGIN §2 — coverage gates.
        crypto and domain packages carry a higher bar (95%); enforced in CI, see ci.yml.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.webcash.iris.auth.crypto</include>
                    <include>com.webcash.iris.auth.domain</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
