<?xml version="1.0" encoding="UTF-8"?>
<!--
  IRIS BizTalk Portal — build definition
  req: CONST-TECH-L01 (Java 17+ / Spring Boot 3.x / Spring Security), ADR-001, ADR-LOGIN-010
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.webcash.iris</groupId>
  <artifactId>iris-portal</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>IRIS BizTalk Portal</name>
  <description>Replacement for the legacy IRIS_ADMIN login and biztalk modules</description>

  <properties>
    <java.version>17</java.version>
    <!--
      req: RISK-007 — sources contain Korean Javadoc and the build machine's javac
      defaults to windows-1252 here. Stated explicitly rather than relying on the
      parent POM, because a silent encoding fallback corrupts comments rather than
      failing the build.
    -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis-starter.version>3.0.3</mybatis-starter.version>
    <bouncycastle.version>1.78.1</bouncycastle.version>
    <totp.version>1.7.1</totp.version>
    <archunit.version>1.3.0</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- req: ADR-003 / ADR-LOGIN-011 — MyBatis retained; legacy SQL ported near-verbatim -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-starter.version}</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- req: FR-LOGIN-005 — Argon2id. Spring Security's Argon2PasswordEncoder needs BouncyCastle -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!--
      req: ADR-LOGIN-010 — maintained TOTP library, NOT a port of GoogleOTP.java.
      Declared now; used in Sprint L2 (OTP verification and registration).
    -->
    <dependency>
      <groupId>dev.samstevens.totp</groupId>
      <artifactId>totp</artifactId>
      <version>${totp.version}</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- version managed by spring-boot-starter-parent -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!--
          `mvn spring-boot:run` 시 local 프로파일을 기본 활성화한다.
          이 설정은 <b>run 골(개발용)에만</b> 적용되며, 패키징된 jar(운영 배포)에는 영향이
          없다. local 프로파일이 빠지면 require-https=true 로 실행되어 모든 요청이
          https://localhost:8443 으로 302 리다이렉트되고 "서버에 연결할 수 없습니다" 오류가
          난다 — 이 실수가 반복되어 기본값으로 고정한다.
          운영에서 HTTPS 를 강제하려면 profiles 없이 빌드된 jar 를 실행하면 된다.

          Activates the `local` profile by default for `mvn spring-boot:run`. This applies only to
          the run goal (development); a packaged jar (production) is unaffected. Without the local
          profile the app runs with require-https=true and 302-redirects everything to
          https://localhost:8443, producing the "cannot connect to server" error. Pinned here
          because this mistake has recurred; production simply runs the built jar with no profile.
        -->
        <configuration>
          <profiles>
            <profile>local</profile>
          </profiles>
        </configuration>
      </plugin>

      <!--
        req: Skill 5 DoD — SBOM 생성 + 금지 OSS 라이선스 0건, TEST-PLAN-LOGIN §5

        이 플러그인이 없어서 CI 가 통과할 수 없었다. `.github/workflows/ci.yml` 의
        `dependencies` job 이 `org.cyclonedx:cyclonedx-maven-plugin:makeAggregateBom` 을
        호출하는데 pom 에 선언이 없었으므로, Maven 이 설치되어 있었더라도 그 job 은
        플러그인 해결에 실패했을 것이다. CI 스크립트와 빌드 정의가 어긋난 채로 아무도
        실행하지 않았기 때문에 드러나지 않았다.

        The CI could not have passed without this: `ci.yml`'s `dependencies` job invokes
        `cyclonedx-maven-plugin`, which the pom never declared — so even with Maven installed that
        job would have failed to resolve the plugin. The CI script and the build definition had
        drifted apart, and nothing ran to reveal it.

        `verify` 에 묶는 이유: SBOM 이 별도 명령으로만 생성되면 잊힌다. 빌드가 만들면
        빌드가 있는 곳마다 있다.
        Bound to `verify` because an SBOM produced only by a separate command gets forgotten;
        produced by the build, it exists wherever the build does.
      -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.8.0</version>
        <executions>
          <execution>
            <id>sbom</id>
            <phase>verify</phase>
            <goals><goal>makeAggregateBom</goal></goals>
          </execution>
        </executions>
        <configuration>
          <outputFormat>all</outputFormat>
          <!-- 테스트 전용 의존성도 포함한다 — 빌드 환경도 공급망이다.
               Test-scoped dependencies are included: the build environment is supply chain too. -->
          <includeTestScope>true</includeTestScope>
        </configuration>
      </plugin>

      <!--
        req: TEST-PLAN-LOGIN §2 — coverage gates.
        crypto and domain packages carry a higher bar (95%); enforced in CI, see ci.yml.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.webcash.iris.auth.crypto</include>
                    <include>com.webcash.iris.auth.domain</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
