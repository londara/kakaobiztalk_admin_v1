# IRIS BizTalk Portal — 로컬 실행 환경변수 / local run environment
#
# req: ADR-007, CONST-SEC-L02, SEC-A02
#
# ⚠ 이 파일은 커밋되지 않는다 (.gitignore). 실제 자격증명이 들어 있다.
#   Git-ignored; holds real credentials.
#
# 어떻게 읽히는가 / how this is read:
#   Spring Boot 는 .env 를 스스로 읽지 않는다. IrisPortalApplication.main() 이
#   SpringApplication.run 앞에서 DotEnv 로 읽어 시스템 속성으로 올린다.
#   IDE 의 `Run main` 링크만 눌러도 동작한다 — 실행 구성도 플래그도 필요하지 않다.
#
#   Spring Boot does not read .env itself. IrisPortalApplication.main() loads it through DotEnv
#   before SpringApplication.run, so the IDE's `Run main` link alone is enough — no launch
#   configuration and no flags.
#
# 형식 / format:  KEY=value  (한 줄에 하나, `#` 은 주석, 값에 = 가 있어도 된다)

# ---------------------------------------------------------------------------
# 데이터베이스 / database
#
# ⚠ 이 비밀번호는 git 이력에 남아 있어 회전 대상이다 (SEC-A02).
#   회전한 뒤에는 이 값도 함께 바꾼다.
#   Pending rotation — already in git history (SEC-A02). Update after rotating.
# ---------------------------------------------------------------------------
IRIS_DB_URL=jdbc:postgresql://136.85.16.4:5432/kakaobiztalkdev
IRIS_DB_USERNAME=biztalk_user
IRIS_DB_PASSWORD=biztalk123

# 테이블과 decrypt()/masking() 함수가 서로 다른 스키마에 있다 — 둘 다 필요하다.
# Tables and the decrypt()/masking() functions live in different schemas; both are required.
IRIS_DB_SCHEMA=kakaobiztalkdevdb

# ---------------------------------------------------------------------------
# OTP 암호화 키 / OTP encryption key
#
# 새로 생성한 값이다. 유출된 옛 키(git 이력)를 쓰지 않는다.
# Freshly generated — deliberately not the leaked key in git history.
#
# ⚠ 공유 개발 DB 에 OTP 를 새로 등록하면 이 로컬 키로만 복호화된다. 기존 로그인 검증에는
#   영향이 없다 — IRIS_OTP_KEY_ENCRYPTED=false 이므로 레거시 OTP_KEY 는 평문 Base32 로
#   그대로 쓰인다.
#   Enrolling a NEW OTP encrypts it under this local key only; verifying existing logins is
#   unaffected because the legacy plaintext Base32 OTP_KEY is used as-is.
#
# 새 키 / generate:  openssl rand -base64 32
# ---------------------------------------------------------------------------
IRIS_OTP_SECRET_KEY=3NUSPSH/zY/iCCzsjwfYk3E2zBZeNJIlHuf4Qd+BxG4=

# ---------------------------------------------------------------------------
# 평문 HTTP 로컬 실행 / running over plain HTTP
#
# ⚠ 운영에서는 두 값 모두 true 여야 한다. 이 파일이 운영에 없으므로 기본값(true)이 유지된다.
#   Both must be true in production; this file is absent there, so the defaults hold.
# ---------------------------------------------------------------------------
IRIS_REQUIRE_HTTPS=false
IRIS_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# 알림톡 / AlimTalk
#
# T = 시험, A = 운영. 'A' 는 A2-02(DB 시퀀스) 전에는 기동에 실패한다 — 메모리 순번이
# 레거시 결함 D-A25 를 재현하기 때문이며, 실패가 올바른 동작이다.
# 'A' fails startup before A2-02 exists: the in-memory sequence would reproduce D-A25.
# ---------------------------------------------------------------------------
IRIS_ATK_ENVIRONMENT=T

IRIS_INSTANCE_NAME=local
IRIS_FORWARD_HEADERS=none
