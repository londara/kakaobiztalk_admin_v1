# 로컬 실행용 환경변수 견본. / Environment-variable template for local runs.
#
# 사용법 / usage:
#   cp .env.example .env      → 값을 채운다 / fill in the values
#
# req: ADR-007, CONST-SEC-L02, VS-001
#
# 이 파일은 <b>이름만</b> 담는다. 값을 채운 `.env` 는 `.gitignore` 에 의해 추적되지 않는다.
# 이 견본이 존재하는 이유: `application.yml` 의 DB·OTP 항목에서 기본값을 제거했으므로
# 환경변수가 없으면 애플리케이션이 <b>기동에 실패한다</b>. 실패는 의도된 동작이지만,
# 무엇을 채워야 하는지 알려주는 곳이 없으면 그 실패는 진단 불가능한 실패가 된다.
#
# This file carries <b>names only</b>; a filled-in `.env` is git-ignored. It exists because the DB
# and OTP entries in `application.yml` no longer have defaults, so the application fails to start
# without these variables. That failure is intended — but without somewhere stating what to supply,
# an intended failure becomes an undiagnosable one.

# ---------------------------------------------------------------------------
# 필수 — 없으면 기동 실패 / Required; startup fails without these
# ---------------------------------------------------------------------------

# JDBC URL. 예 / example: jdbc:postgresql://localhost:5432/kakaobiztalkdev
IRIS_DB_URL=

IRIS_DB_USERNAME=

IRIS_DB_PASSWORD=

# Base64 로 인코딩된 32바이트(AES-256) 키. 생성 / generate:
#   openssl rand -base64 32
#
# ⚠ 이 키는 OTP 비밀을 암호화한다. 키를 교체하면 기존 OTP 비밀은 복호화되지 않으므로
#   재암호화 또는 재등록이 필요하다.
#   This key encrypts OTP secrets; replacing it requires re-encryption or re-enrolment, because
#   existing secrets will no longer decrypt.
IRIS_OTP_SECRET_KEY=

# ---------------------------------------------------------------------------
# 선택 — 기본값이 있다 / Optional; defaults exist
# ---------------------------------------------------------------------------

# 두 스키마를 쉼표로 구분한다 / comma-separated search_path
IRIS_DB_SCHEMA=

# 로컬 개발에서는 false. 운영에서 true 가 기본이며, 잊어서 평문이 열리는 방향의
# 기본값은 두지 않는다.
# false for local development; production defaults to true, and the default never fails open.
IRIS_REQUIRE_HTTPS=false
IRIS_COOKIE_SECURE=false
IRIS_FORWARD_HEADERS=false

IRIS_INSTANCE_NAME=local
IRIS_ATK_ENVIRONMENT=
