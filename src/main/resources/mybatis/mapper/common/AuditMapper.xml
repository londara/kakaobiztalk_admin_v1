<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  source: WSVC.*.xml — mntLogYn=Y (behaviour supplied by the Jex runtime, not by any
          biztalk or auth source file; see RISK-002)
  req:    NFR-OPS-AUDIT-L01, NFR-OPS-AUDIT-L02, ADR-006

  추가 전용 / append-only:
    UPDATE·DELETE 문을 정의하지 않는다. 애플리케이션 경로에 없는 기능은 실수로도
    호출되지 않으므로, 추가 전용 성질이 규율이 아니라 구조로 보장된다.
    No UPDATE or DELETE statement is defined. A capability absent from the application
    cannot be invoked by mistake, which makes append-only structural rather than a
    matter of discipline. Retention disposal runs as a separate, privileged job.
-->
<mapper namespace="com.webcash.iris.common.audit.AuditService$AuditMapper">

  <insert id="insert">
    INSERT INTO IRIS_AUTH_AUDIT (
        OCCURRED_AT, ACTOR, TARGET_ACCOUNT, ACTION, OUTCOME, DETAIL, SOURCE_IP, CORRELATION_ID
    ) VALUES (
        #{e.occurredAt}, #{e.actor}, #{e.targetAccount}, #{e.action},
        #{e.outcome}, #{e.detail}, #{e.sourceIp}, #{e.correlationId}
    )
  </insert>

</mapper>
