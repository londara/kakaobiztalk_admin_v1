<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  ============================================================================
  발신번호 원장 조회 / sender-number ledger queries
  ============================================================================
  원본 / origin: IDO.KKB_DPNO_LDGR_L002 (list), IDO.KKB_DPNO_LDGR_L001 (single)

  이식 원칙은 문자내역 슬라이스와 같다: SQL 을 near-verbatim 으로 옮기고, 변경한 줄에는
  하이픈 두 개로 시작하는 `FIX D-Sn:` SQL 주석을 남긴다.
  Same porting principle as the 문자내역 slice: carry the SQL across near-verbatim and mark
  every altered line with a `FIX D-Sn:` SQL line comment.

  ============================================================================
  적용한 수정 / corrections applied
  ============================================================================
  D-S17  레거시는 masking(decrypt(RGSR_NM)) 과 masking(decrypt(UDT_NM)) 에 별칭을 주지
         않아 <out> 매핑이 위치 기반이었다. 서비스 계약은 쿼리가 반환하지 않는 ISNM 도
         선언했다. 여기서는 모든 컬럼에 별칭을 주고 이름으로 매핑한다.
         The legacy left two masked columns unaliased, making the output mapping positional,
         and the contract declared an ISNM the query never returns. Every column is aliased
         here and mapped by name.

  D-S14  ORDER BY 가 없었다. 페이징이 없을 때는 드러나지 않지만, 페이징을 복원하면 순서
         없는 결과는 페이지마다 행이 겹치거나 누락된다.
         There was no ORDER BY. Invisible without paging; with paging restored, an unordered
         result duplicates and drops rows across pages.

  D-S14  LIMIT / OFFSET 이 없어 전체 목록이 매 요청 전송되었다.
         No LIMIT/OFFSET: the whole list was shipped on every request.

  ============================================================================
  조회 형태 / lookup form
  ============================================================================
  decrypt(DP_NO) = #{number} 는 인덱스를 타지 못한다. 그러나 ENCRYPT 의 결정성이 확인되기
  전까지(S1-01) 이 형태만이 두 경우 모두에서 옳다. DP_NO = ENCRYPT(#{number}) 는 결정적일
  때만 동작하며, 비결정적이면 조용히 0건을 반환한다 — D-S1 과 같은 실패 방식이다.
  decrypt(DP_NO) = #{number} cannot use an index, but until S1-01 confirms ENCRYPT's
  determinism it is the only form correct under both branches. The indexed form returns
  silently nothing if ENCRYPT is non-deterministic — D-S1's failure mode.
  req: ADR-SND-018, RISK-S08
-->
<mapper namespace="com.webcash.iris.biztalk.infra.db.SenderNumberMapper">

  <resultMap id="senderNumberEntity" type="com.webcash.iris.biztalk.domain.SenderNumberEntity">
    <constructor>
      <arg column="IS_CD"   javaType="java.lang.String"/>
      <arg column="IS_NM"   javaType="java.lang.String"/>
      <arg column="DP_NO"   javaType="java.lang.String"/>
      <arg column="RGSR_NM" javaType="java.lang.String"/>
      <arg column="RGDT"    javaType="java.lang.String"/>
      <arg column="UDT_NM"  javaType="java.lang.String"/>
      <arg column="UDDT"    javaType="java.lang.String"/>
      <arg column="DSCP"    javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <!--
    req: FR-SND-003
    전체 건수. 0 이면 서비스가 목록 쿼리를 실행하지 않는다.
    Total count; the service skips the row query when it is zero.
  -->
  <select id="count" resultType="int">
    SELECT count(*)
      FROM KKB_DPNO_LDGR
     WHERE IS_CD = #{criteria.institutionCode}
  </select>

  <!--
    source: IDO.KKB_DPNO_LDGR_L002
    req: FR-SND-001, FR-SND-003, FR-SND-004, FR-SND-005, FR-SND-008, NFR-SEC-PII-D02
  -->
  <select id="findPage" resultMap="senderNumberEntity">
    SELECT A.IS_CD                                AS IS_CD,
           (SELECT B.ISNM
              FROM FT_FTIS_INFO B
             WHERE B.FINTECH_ISCD = A.IS_CD)      AS IS_NM,
           decrypt(A.DP_NO)                       AS DP_NO,
           masking(decrypt(A.RGSR_NM))            AS RGSR_NM, -- FIX D-S17: 별칭 추가 / alias added
           A.RGDT                                 AS RGDT,
           masking(decrypt(A.UDT_NM))             AS UDT_NM,  -- FIX D-S17: 별칭 추가 / alias added
           A.UDDT                                 AS UDDT,
           A.DSCP                                 AS DSCP
      FROM KKB_DPNO_LDGR A
     WHERE A.IS_CD = #{criteria.institutionCode}
     -- FIX D-S14: 레거시에 ORDER BY 가 없었다. RGDT 만으로는 동률이 가능하므로 DP_NO 를
     --            보조 키로 두어 순서를 전순서로 만든다 — 그래야 페이징이 안정된다.
     --            The legacy had no ORDER BY. RGDT alone can tie, so DP_NO makes the order
     --            total, which is what makes paging stable.
     ORDER BY A.RGDT DESC, decrypt(A.DP_NO) ASC
     -- FIX D-S14: LIMIT/OFFSET 자체가 없었다 / no LIMIT/OFFSET existed at all
     LIMIT #{criteria.size} OFFSET #{criteria.offset}
  </select>

  <!--
    source: IDO.KKB_DPNO_LDGR_L001
    req: FR-SNDU-002, FR-SNDD-002
    RGSR_NM/UDT_NM 은 상세에서도 마스킹한다 — 목록과 상세가 다르게 보이는 상태가
    D-S1 을 낳았으므로, 두 화면의 표현을 일치시킨다.
    Names are masked on the detail view too: list and detail disagreeing is what produced
    D-S1, so both screens present the same way.
  -->
  <select id="findOne" resultMap="senderNumberEntity">
    SELECT A.IS_CD                                AS IS_CD,
           (SELECT B.ISNM
              FROM FT_FTIS_INFO B
             WHERE B.FINTECH_ISCD = A.IS_CD)      AS IS_NM,
           decrypt(A.DP_NO)                       AS DP_NO,
           masking(decrypt(A.RGSR_NM))            AS RGSR_NM,
           A.RGDT                                 AS RGDT,
           masking(decrypt(A.UDT_NM))             AS UDT_NM,
           A.UDDT                                 AS UDDT,
           A.DSCP                                 AS DSCP
      FROM KKB_DPNO_LDGR A
     WHERE A.IS_CD = #{institutionCode}
       AND decrypt(A.DP_NO) = #{number}
  </select>

  <!--
    ==========================================================================
    쓰기 경로 / the write path — Sprint S2a
    ==========================================================================
    원본 / origin: IDO.KKB_DPNO_LDGR_C001 (등록), IDO.KKB_DPNO_HIS_C001 (이력),
                   IDO.KKB_DPNO_LDGR_D001 (삭제)

    레거시 SQL 을 near-verbatim 으로 옮기고 고친 줄에만 `FIX D-Sn:` 주석을 남긴다.
    아래 세 문장은 레거시 원문을 그대로 인용해 둔다 — 무엇을 고쳤는지 비교할 수 있어야 한다.

      KKB_DPNO_LDGR_C001
        INSERT INTO KKB_DPNO_LDGR (IS_CD,DP_NO, RGDT, RGSR_ID , RGSR_NM ,UDDT, UDT_ID,UDT_NM, DSCP)
        VALUES ( :IS_CD, ENCRYPT(:DP_NO), to_char(now(),'YYYYMMDDHH24MISS'), :RGSR_ID,
                 ENCRYPT(:RGSR_NM), to_char(now(),'YYYYMMDDHH24MISS'), :UDT_ID,
                 ENCRYPT(:UDT_NM), :DSCP)

      KKB_DPNO_HIS_C001
        INSERT INTO KKB_DPNO_HIS (IS_CD, DP_NO, ACN, RGDT, RGSR_ID, RGSR_NM, REASON)
        VALUES ( :IS_CD, ENCRYPT(:DP_NO), :ACN, to_char(now(),'YYYYMMDDHH24MISS'),
                 :RGSR_ID, ENCRYPT(:RGSR_NM), :REASON)

      KKB_DPNO_LDGR_D001
        DELETE FROM KKB_DPNO_LDGR WHERE IS_CD = :IS_CD AND decrypt(DP_NO)= :DP_NO

    ==========================================================================
    적용한 수정 / corrections applied
    ==========================================================================
    D-S9   중복검사가 KKB_DPNO_LDGR_L001 을 재사용해 IS_CD 술어를 함께 걸었으므로 요청
           기관 자신의 번호만 보았다. countAnywhere 에는 기관 술어가 없다 — 그 부재가
           FR-SNDC-004(전역 유일)의 구현이다.
           The duplicate check reused L001 and so carried its IS_CD predicate, seeing only the
           requesting institution's rows. countAnywhere has no institution predicate; that
           absence *is* FR-SNDC-004.

    D-S16  RGSR_ID / UDT_ID 는 운영자 이메일을 평문으로 담았고 RGSR_NM 은 암호화되어
           있었다 — 같은 사람의 같은 신원이 한 행에서 두 방식으로 저장되었다. AMB-S09
           결정 B 에 따라 ID 컬럼도 ENCRYPT() 를 통과한다.
           RGSR_ID / UDT_ID held the operator email in clear while RGSR_NM was encrypted: one
           person's identity stored two ways in one row. Under AMB-S09 ruling B the ID columns
           pass through ENCRYPT() too.

    D-S1   삭제는 행 이동으로 구현된다(archive → deleteLive). 상태 컬럼이 아닌 이유는
           KAKAOTALK 이 KKB_DPNO_LDGR 의 행 존재만으로 발송 가능 여부를 판단하기
           때문이다(ADR-SND-017). deleteLive 의 반환값은 호출자가 반드시 확인한다.
           Deletion is a row move (archive → deleteLive), not a status flag, because KAKAOTALK
           decides sending rights by row presence alone (ADR-SND-017). The caller must check
           deleteLive's row count.
  -->

  <!--
    source: IDO.KKB_DPNO_LDGR_L001 — with its IS_CD predicate deliberately absent
    req: FR-SNDC-004, CONST-BIZ-D01
  -->
  <select id="countAnywhere" resultType="int">
    SELECT count(*)
      FROM KKB_DPNO_LDGR
     <!-- FIX D-S9: IS_CD 술어가 없다. 있으면 기관별 유일이 되어 D-S9 가 그대로 남는다.
                    No IS_CD predicate: with one, uniqueness is per-institution and D-S9 stands. -->
     WHERE decrypt(DP_NO) = #{number}
  </select>

  <!--
    source: IDO.KKB_DPNO_LDGR_C001
    req: FR-SNDC-001, FR-SNDC-009, NFR-SEC-PII-D01
  -->
  <insert id="insertLedger">
    INSERT INTO KKB_DPNO_LDGR (
      IS_CD, DP_NO, RGDT, RGSR_ID, RGSR_NM, UDDT, UDT_ID, UDT_NM, DSCP)
    VALUES (
      #{command.institutionCode},
      ENCRYPT(#{command.number}),
      to_char(now(),'YYYYMMDDHH24MISS'),
      <!-- FIX D-S16: 레거시는 :RGSR_ID 를 평문으로 넣었다 / the legacy bound it in clear -->
      ENCRYPT(#{command.actorId}),
      ENCRYPT(#{command.actorId}),
      to_char(now(),'YYYYMMDDHH24MISS'),
      <!-- FIX D-S16: 같은 이유 / same reason -->
      ENCRYPT(#{command.actorId}),
      ENCRYPT(#{command.actorId}),
      #{command.description})
  </insert>

  <!--
    source: IDO.KKB_DPNO_HIS_C001
    req: FR-SNDD-004, FR-SNDH-001, FR-SNDH-003

    DP_NO 는 <b>번호 하나</b>다. 레거시 다중 삭제는 여기에 콤마로 이어붙인 목록을 넣어
    ENCRYPT("010...,010...,010...") 를 하나의 "번호" 로 저장했다(D-S5). 매퍼 시그니처가
    문자열 하나를 받으므로 목록을 넣을 자리가 없다 — 구조로 막는다.
    DP_NO is <b>one number</b>. The legacy multi-delete put the comma-joined list here, storing
    ENCRYPT("010…,010…,010…") as a single "number" (D-S5). The mapper signature takes one string,
    so there is nowhere for a list to go — the guard is structural.
  -->
  <insert id="insertHistory">
    INSERT INTO KKB_DPNO_HIS (
      IS_CD, DP_NO, ACN, RGDT, RGSR_ID, RGSR_NM, REASON)
    VALUES (
      #{command.institutionCode},
      ENCRYPT(#{command.number}),
      #{command.action},
      to_char(now(),'YYYYMMDDHH24MISS'),
      <!-- FIX D-S16 -->
      ENCRYPT(#{command.actorId}),
      ENCRYPT(#{command.actorId}),
      #{command.reason})
  </insert>

  <!--
    req: FR-SNDD-001, FR-SNDD-003, ADR-SND-017, CONST-DATA-D04

    아카이브는 <b>저장된 그대로</b> 복사한다 — DP_NO 를 복호화해 다시 암호화하지 않는다.
    두 가지 이유가 있다. 하나, ENCRYPT 가 비결정적이면 재암호화된 값은 원본과 다른
    바이트열이 되어 복원한 행이 원래 행과 같지 않다(S1-01 미확정). 둘, 복원은 이 테이블의
    존재 이유이며(FR-SNDD-008, C-S02) 복원이 원본과 다르면 아카이브가 아니다.
    The archive copies the row <b>as stored</b>: DP_NO is not decrypted and re-encrypted. Two
    reasons. If ENCRYPT is non-deterministic (S1-01 unresolved) a re-encrypted value is a
    different byte sequence, so a restored row would not equal the original. And restoration is
    this table's reason to exist (FR-SNDD-008, C-S02) — an archive that restores something else
    is not an archive.
  -->
  <insert id="archive">
    INSERT INTO KKB_DPNO_ARCV (
      IS_CD, DP_NO, RGDT, RGSR_ID, RGSR_NM, UDDT, UDT_ID, UDT_NM, DSCP,
      DEL_DT, DEL_ID, REASON)
    SELECT A.IS_CD,
           A.DP_NO,
           A.RGDT,
           A.RGSR_ID,
           A.RGSR_NM,
           A.UDDT,
           A.UDT_ID,
           A.UDT_NM,
           A.DSCP,
           to_char(now(),'YYYYMMDDHH24MISS'),
           ENCRYPT(#{actorId}),
           #{reason}
      FROM KKB_DPNO_LDGR A
     WHERE A.IS_CD = #{institutionCode}
       AND decrypt(A.DP_NO) = #{number}
  </insert>

  <!--
    source: IDO.KKB_DPNO_LDGR_D001
    req: FR-SNDD-001, FR-SNDD-002, NFR-OPS-D02

    문장 자체는 레거시와 같다. 달라진 것은 <b>반환값을 확인한다</b>는 점이다 — 0건 삭제를
    무시한 것이 D-S1 이었고, 그 확인은 SQL 이 아니라 서비스가 한다.
    The statement is the legacy's. What changed is that <b>the row count is checked</b>: ignoring
    a zero-row delete was D-S1, and that check lives in the service, not in the SQL.
  -->
  <delete id="deleteLive">
    DELETE FROM KKB_DPNO_LDGR
     WHERE IS_CD = #{institutionCode}
       AND decrypt(DP_NO) = #{number}
  </delete>

</mapper>
