<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  source: IDO.USER_LDGR_R006 / USER_LDGR_LOGIN_ATTEMPT_U001 / USER_LDGR_U006 /
          USER_LDGR_U009 / USER_LDGR_U010 / USER_GRP_JNNG_INFM_R001
  req:    FR-LOGIN-002/003/004/005/010/018/020, CONST-DATA-L01

  이식 원칙 / porting principle:
    레거시 SQL 을 near-verbatim 으로 옮기고, 변경한 줄에는 하이픈 두 개로 시작하는
    `FIX Ln:` SQL 주석을 남긴다.
    레거시 소스가 유일한 명세이므로(RISK-001) 변경점이 리뷰 가능해야 한다.
    The legacy SQL is carried across near-verbatim and every altered line carries a
    `FIX Ln:` SQL line comment (prefixed by two hyphens), because the legacy source is
    the only specification and the delta must be reviewable line by line.

  추가 전용 DDL / additive-only DDL:
    PWD_HASH / PWD_SCHEME 는 신규 컬럼이며 레거시 PWD 컬럼은 건드리지 않는다.
    같은 테이블을 계속 읽는 레거시 시스템이 그대로 동작하고, 롤백 창 동안 구 해시가
    남는다 (RISK-L04).
    PWD_HASH / PWD_SCHEME are new columns; the legacy PWD column is untouched, so the
    still-running legacy keeps working and the old hash survives the rollback window.
-->
<mapper namespace="com.webcash.iris.auth.infra.db.UserMapper">

  <resultMap id="userAccountMap" type="com.webcash.iris.auth.domain.UserAccount">
    <constructor>
      <arg column="EML"                  javaType="java.lang.String"/>
      <arg column="PWD_HASH"             javaType="java.lang.String"/>
      <arg column="PWD"                  javaType="java.lang.String"/>
      <arg column="OTP_KEY"              javaType="java.lang.String"/>
      <arg column="LOGIN_ATTEMPT"        javaType="_int"/>
      <arg column="OTP_FAIL_CNT"         javaType="_int"/>
      <arg column="JNNG_STTS"            javaType="com.webcash.iris.auth.domain.AccountStatus"/>
      <arg column="LAST_LOGIN_DT"        javaType="java.time.LocalDate"/>
      <arg column="LAST_CHNG_PWD_DT"     javaType="java.time.LocalDate"/>
      <arg column="PWD_INIT_FLAG"        javaType="_boolean"/>
      <arg column="OPERATOR_FLAG"        javaType="_boolean"/>
      <arg column="IS_CD"                javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <!--
    source: IDO.USER_LDGR_R006
    req: FR-LOGIN-002

    PWD_INIT_YN 의미 — PM 결정(2026-08-17)으로 <b>직관적 방향</b>으로 재정렬한다.
      · 'Y' = 초기(임시) 비밀번호 상태 → 로그인 시 변경 강제
      · 'N' = 사용자가 비밀번호를 변경 완료 → 정상 로그인
    컬럼명(PWD_INIT_YN)의 자연스러운 해석과 일치한다.

    ⚠ 레거시(apc_login_proc_act.jsp)는 <b>반대</b>였다: 'N' 이 변경을 강제했다
      (if("N".equals(pwdInitYn)) CHNG_PWD). 이 프로젝트는 그 관례를 뒤집기로 했다.
      읽기(이 CASE), 쓰기(updatePasswordHash='N', resetPasswordHash='Y')를 함께 뒤집어
      전체가 일관되게 "Y = 변경 필요" 를 뜻하도록 한다.

    PM ruling (2026-08-17): the column is realigned to its intuitive direction — 'Y' = initial
    (temporary) password → force a change; 'N' = user has changed it → normal login. This is the
    opposite of the legacy (which forced a change on 'N'); the read here and the two write sites
    are flipped together so the whole column consistently means "Y = must change".
  -->
  <select id="findByEmail" resultMap="userAccountMap">
    SELECT
        U.EML,
        <!--
          PM 결정(2026-08-17): a_user_ldgr 에 PWD_HASH 컬럼이 없다. 레거시 PWD(Base64 SHA-256)만
          사용한다. 존재하지 않는 컬럼을 참조하지 않도록 NULL 을 매핑한다 — passwordHash 가
          null 이면 hasModernHash()=false 가 되어 로그인이 항상 레거시 PWD 경로를 탄다.
          The a_user_ldgr table has no PWD_HASH column; only the legacy PWD (Base64 SHA-256) is
          used. NULL is mapped so the missing column is never referenced; a null passwordHash makes
          hasModernHash() false, so login always takes the legacy PWD path.
        -->
        CAST(NULL AS VARCHAR) AS PWD_HASH,
        U.PWD,
        U.OTP_KEY,
        <!--
          LOGIN_ATTEMPT 는 실제 스키마에서 <b>character varying</b> 이다 (numeric 이 아니다).
          `COALESCE(U.LOGIN_ATTEMPT, 0)` 은 PostgreSQL 에서
          "COALESCE types character varying and integer cannot be matched" 로 실패한다.
          빈 문자열도 존재할 수 있으므로 NULLIF 로 걸러낸 뒤 정수로 변환한다.

          LOGIN_ATTEMPT is character varying in the live schema, so coalescing it with an integer
          fails outright; blank strings are possible too, hence NULLIF before the cast.
          OTP_FAIL_CNT is genuinely numeric and needs no conversion.
        -->
        CAST(COALESCE(NULLIF(U.LOGIN_ATTEMPT, ''), '0') AS INTEGER) AS LOGIN_ATTEMPT,
        COALESCE(U.OTP_FAIL_CNT, 0)                        AS OTP_FAIL_CNT,
        U.JNNG_STTS,
        TO_DATE(NULLIF(U.LAST_LOGIN_DT, ''), 'YYYYMMDD')   AS LAST_LOGIN_DT,
        TO_DATE(NULLIF(U.LAST_CHNG_PWD_DT, ''), 'YYYYMMDD') AS LAST_CHNG_PWD_DT,
        <!-- PM 2026-08-17: PWD_INIT_FLAG = (PWD_INIT_YN = 'N'). 변경 페이지는 이 플래그가
             true 이면서 마지막 변경일이 90일 이상일 때만 표시된다(AccountPolicy 참조).
             null 은 'N' 이 아니므로 false → 변경 강제하지 않음.
             PWD_INIT_FLAG = (PWD_INIT_YN = 'N'); the change page shows only when this is true AND
             the password is 90+ days old (see AccountPolicy). NULL is not 'N' → false. -->
        CASE WHEN U.PWD_INIT_YN = 'N' THEN TRUE ELSE FALSE END AS PWD_INIT_FLAG,
        CASE WHEN EXISTS (
            SELECT 1 FROM a_user_grp_jnng_infm G
             WHERE G.EML = U.EML AND G.GRP_ID = 'GRP_0'
        ) THEN TRUE ELSE FALSE END                          AS OPERATOR_FLAG,
        <!--
          req: FR-TEN-001 — 사용자의 소속 이용기관. 테넌트 격리의 근거가 되는 값이다.

          ══════════════════════════════════════════════════════════════════════════
          AMB-M01 — 해소됨: 그런 매핑은 <b>존재하지 않는다</b> (2026-08-17 실측)
          ══════════════════════════════════════════════════════════════════════════
          운영 스키마를 직접 조회하여 확인했다:

            · a_user_ldgr            21개 컬럼 중 이용기관 코드 없음 (IS_CD 부재)
            · a_user_grp_jnng_infm   GRP_0 / GRP_1 뿐 — 역할 그룹이며 기관 코드가 아니다
                                     kkb_inst_info 와 조인 시 0건
            · kkb_mngr_ldgr          운영자 이메일 목록. 기관 코드 없음
            · kkb_inst_info          <b>빈 테이블</b>
            · cmnm / brc / user_dsnc 전 사용자 null 또는 공백

          따라서 이전 가정(U.IS_CD)은 틀렸고, 그대로 두면 로그인 쿼리가
          `column u.is_cd does not exist` 로 실패한다.

          Verified against the live schema: no user → 이용기관 mapping exists anywhere.
          The previous assumption was wrong and made every login fail.

          ── 잠정 조치 / interim behaviour ──────────────────────────────────────────
          NULL 을 반환한다. NULL 은 "소속 기관 미상"을 뜻하며, TenantContext 가 이를
          <b>운영자에게만</b> 전체 조회로 해석하고 <b>일반 사용자에게는 접근 거부</b>로
          해석한다(fail-closed). 조용히 전체 공개로 퇴화하지 않게 하기 위함이다.

          NULL means "institution unknown": TenantContext reads it as full scope for an
          operator and as <b>denial</b> for anyone else. A tenant control that silently
          degrades to "everyone sees everything" is worse than one that visibly blocks.

          ⚠ PM/DBA 결정 필요: 이용기관 소속을 어디에 둘 것인가(신규 컬럼 / 매핑 테이블 /
            kkb_inst_info 채우기). 그때까지 일반 사용자는 문자내역을 조회할 수 없다.
        -->
        CAST(NULL AS VARCHAR)                               AS IS_CD
      FROM a_user_ldgr U
     WHERE U.EML = #{email}
  </select>

  <!--
    source: IDO.USER_LDGR_LOGIN_ATTEMPT_U001
    req: FR-LOGIN-003, TM-L010

    레거시는 애플리케이션이 계산한 값을 그대로 UPDATE 했다. 동시 시도에서 갱신이
    유실되면 잠금이 무력화되므로 DB 에서 원자적으로 증가시킨다.
    The legacy wrote an application-computed value. A lost update under concurrent
    attempts would defeat the lockout, so the increment is atomic in the database.
  -->
  <select id="incrementLoginAttempt" resultType="int">
    UPDATE a_user_ldgr
       -- FIX L-concurrency: atomic increment
       -- FIX schema: LOGIN_ATTEMPT is character varying, so the arithmetic needs an explicit
       --             cast in and a cast back out. Verified against the live schema 2026-08-17.
       SET LOGIN_ATTEMPT = CAST(
             CAST(COALESCE(NULLIF(LOGIN_ATTEMPT, ''), '0') AS INTEGER) + 1 AS VARCHAR)
     WHERE EML = #{email}
    RETURNING CAST(LOGIN_ATTEMPT AS INTEGER)
  </select>

  <!-- source: IDO.USER_LDGR_U006 / req: FR-LOGIN-010 -->
  <select id="incrementOtpFailCount" resultType="int">
    UPDATE a_user_ldgr
       SET OTP_FAIL_CNT = COALESCE(OTP_FAIL_CNT, 0) + 1     -- FIX L-concurrency: atomic increment
     WHERE EML = #{email}
    RETURNING OTP_FAIL_CNT
  </select>

  <!-- source: IDO.USER_LDGR_U009 / req: FR-LOGIN-004 -->
  <update id="resetFailureCounters">
    UPDATE a_user_ldgr
       -- FIX schema: LOGIN_ATTEMPT is character varying — an integer literal is rejected.
       SET LOGIN_ATTEMPT = '0',
           OTP_FAIL_CNT  = 0
     WHERE EML = #{email}
  </update>

  <!-- source: IDO.USER_LDGR_U010 / req: FR-LOGIN-020 -->
  <update id="touchLastLogin">
    UPDATE a_user_ldgr
       SET LAST_LOGIN_DT = TO_CHAR(NOW(), 'YYYYMMDD')
     WHERE EML = #{email}
  </update>

  <!--
    req: FR-LOGIN-005, FR-PWD-006, RISK-L04
    레거시 PWD 컬럼은 갱신하지 않는다 — 롤백 창 동안 레거시가 계속 읽을 수 있어야 한다.
    The legacy PWD column is NOT updated: the legacy must keep reading it during the
    rollback window (RISK-L04).
  -->
  <update id="updatePasswordHash">
    UPDATE a_user_ldgr
       <!-- PM 2026-08-17: PWD_HASH/PWD_SCHEME 컬럼이 없다. 레거시 PWD 에 직접 쓴다.
            #{hash} 는 legacySha256Base64(newPassword) — 로그인이 PWD 를 검증하므로 일관된다.
            No PWD_HASH/PWD_SCHEME columns; write the legacy PWD directly. #{hash} is the
            Base64 SHA-256 of the new password, consistent with the PWD login check. -->
       SET PWD              = #{hash},
           LAST_CHNG_PWD_DT = TO_CHAR(NOW(), 'YYYYMMDD'),
           PWD_INIT_YN      = 'N'   <!-- change 완료 = 'N' (더 이상 초기 아님) -->
     WHERE EML = #{email}
  </update>

  <!--
    req: FR-PWD-007, FR-LOGIN-015 — operator-set temporary password.
    PWD_INIT_YN='Y' 로 표시하여 다음 로그인에서 변경을 강제한다(PM 2026-08-17, 레거시의
    'N' 에서 반전). 레거시 PWD 컬럼은 여기서도 건드리지 않는다 (RISK-L04).
    Marked PWD_INIT_YN='Y' so the next login forces a change (inverted from the legacy 'N' per the
    PM ruling). The legacy PWD column is left untouched here too (RISK-L04).
  -->
  <update id="resetPasswordHash">
    UPDATE a_user_ldgr
       <!-- PM 2026-08-17: 레거시 PWD 에 직접 쓴다(PWD_HASH/PWD_SCHEME 컬럼 없음).
            #{hash} 는 legacySha256Base64(temporary). / Writes the legacy PWD directly. -->
       SET PWD              = #{hash},
           LAST_CHNG_PWD_DT = TO_CHAR(NOW(), 'YYYYMMDD'),
           PWD_INIT_YN      = 'Y',
           LOGIN_ATTEMPT    = 0
     WHERE EML = #{email}
  </update>

  <!-- req: FR-PWD-004 -->
  <select id="findRecentPasswordHashes" resultType="java.lang.String">
    SELECT PWD_HASH
      FROM IRIS_USER_PWD_HISTORY
     WHERE EML = #{email}
     ORDER BY CHNG_AT DESC
     LIMIT #{limit}
  </select>

  <!-- req: FR-PWD-004 -->
  <insert id="insertPasswordHistory">
    INSERT INTO IRIS_USER_PWD_HISTORY (EML, PWD_HASH, CHNG_AT)
    VALUES (#{email}, #{hash}, NOW())
  </insert>

  <!--
    req: FR-OTP-005, NFR-SEC-PII-L01
    저장 전에 애플리케이션에서 AES-256-GCM 으로 암호화한다(SecretCipher).
    Encrypted with AES-256-GCM in the application before it reaches here (SecretCipher).
  -->
  <update id="updateOtpKey">
    UPDATE a_user_ldgr
       SET OTP_KEY      = #{encryptedKey},
           OTP_FAIL_CNT = 0
     WHERE EML = #{email}
  </update>

  <!--
    req: FR-OTP-007 — operator reset, the sole recovery path for a lost device
    source: apm_1001_03_r001_act.jsp threw ADM_00026 with no recovery path defined
  -->
  <update id="clearOtpKey">
    UPDATE a_user_ldgr
       SET OTP_KEY      = NULL,
           OTP_FAIL_CNT = 0
     WHERE EML = #{email}
  </update>

  <!--
    source: IDO.USER_GRP_JNNG_INFM_R001 — GRP_0 → admin (USER_DSNC='A'), GRP_1 → user
    req: FR-LOGIN-018
  -->
  <select id="isOperator" resultType="boolean">
    SELECT EXISTS (
        SELECT 1
          FROM a_user_grp_jnng_infm
         WHERE EML = #{email}
           AND GRP_ID = 'GRP_0'
    )
  </select>

</mapper>
